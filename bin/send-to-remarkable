#!/usr/bin/env bash
# Resolve the repo root even when invoked via a symlink on PATH.
source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
  source_path="$(readlink "$source_path")"
  [[ $source_path != /* ]] && source_path="$dir/$source_path"
done
repo="$(cd -P "$(dirname "$source_path")/.." >/dev/null 2>&1 && pwd)"
exec node "$repo/cli.ts" "$@"
