{
  "manifest_version": 3,
  "name": "Send to reMarkable (lab)",
  "description": "Extract readable content, pick elements visually, and send as a nicely typeset EPUB to your reMarkable.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://webapp-prod.cloud.remarkable.engineering/*",
    "https://internal.cloud.remarkable.com/*",
    "https://eu.tectonic.remarkable.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Send to reMarkable",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
